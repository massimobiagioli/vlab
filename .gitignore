# Build output
/target/

# Local databases, checkouts, and secrets. The settings example stays tracked so
# a fresh clone can copy it to settings.yaml.
/.data/*
!/.data/settings.example.yaml
/.workspace/
*.db
*.db-wal
*.db-shm
.env
.env.*

# Local scratch and planning (ADR-0007, ADR-0037): the implementation plan and
# feature plans are tracked; other .project content stays local.
/.tmp/
/.project/*
!/.project/IMPLEMENTATION-PLAN.md
!/.project/features/
!/.project/features/*.md

# Tool-local state
/.claude/
/.serena/

# OS artifacts and editor backups
.DS_Store
*.swp
*.swo
*~
